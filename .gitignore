# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# tfvars files (secrets & env-specific values)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.plan
*.tfplan

# Lock file (optional but usually committed)
# Uncomment if you don't want it in repo
 .terraform.lock.hcl

# IDE and editor folders
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Python virtual environments (if used for automation)
.venv/
__pycache__/

# Backup files
*.bak
*.backup
